# ── Application ──────────────────────────────────────────────
# Environment: "dev" or "prod"
APP_ENV=dev

# ── FalkorDB (graph database) ───────────────────────────────
# Hostname of the FalkorDB instance
FALKORDB_HOST=localhost
# Redis-protocol port for FalkorDB
FALKORDB_PORT=6379
# Password for FalkorDB (required in prod, leave empty for dev)
FALKORDB_PASSWORD=

# ── Authentication ───────────────────────────────────────────
# Random string, 64+ chars; required in prod (app refuses to start without it)
JWT_SECRET=
# Token lifetime in minutes
JWT_EXPIRE_MINUTES=60

# ── Bootstrap admin (created only if no users exist) ────────
# Email for the initial admin account
ADMIN_EMAIL=
# Password for the initial admin account
ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Ingestion ────────────────────────────────────────────────
# Temporary folder for git clones
WORK_DIR=/tmp/reachguard
# Maximum repository size in MB
MAX_REPO_MB=100
# Maximum ZIP upload size in MB
MAX_ZIP_MB=50
# Maximum number of Python files to parse
MAX_PY_FILES=5000

# ── OSV (vulnerability database) ────────────────────────────
# Base URL for the OSV API
OSV_BASE_URL=https://api.osv.dev
# Local cache directory for real OSV responses
OSV_CACHE_DIR=/data/osv_cache

# ── LLM ─────────────────────────────────────────────────────
# Provider: "ollama", "openai_compat", or "none"
LLM_PROVIDER=ollama
# OpenAI-compatible base URL
LLM_BASE_URL=http://localhost:11434/v1
# Model name
LLM_MODEL=qwen2.5:7b-instruct
# API key (only for hosted free tiers, leave empty otherwise)
LLM_API_KEY=a71a82d633b44503818898160e2deac0.NAIBFa0QL9xZ7IKGJETocuuH
# Request timeout in seconds
LLM_TIMEOUT_S=60
